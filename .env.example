# Copy this file to .env and fill in private credentials only.
# .env and .env.pc are gitignored. Operational settings belong in
# config/runtime.json or the gitignored config/runtime.local.json override.

# --- MySQL credentials (optional; app runs without it) ---
MYSQL_USER=
MYSQL_PASSWORD=

# --- Shared execution-coordination credentials ---
COORD_DB_USER=
COORD_DB_PASSWORD=

# --- KIS broker credentials: production ---
KIS_PROD_APP_KEY=
KIS_PROD_APP_SECRET=
KIS_PROD_ACCOUNT_NO=

# --- KIS broker credentials: simulation/paper ---
KIS_SIM_APP_KEY=
KIS_SIM_APP_SECRET=
KIS_SIM_ACCOUNT_NO=

# KIS HTS identity used for verified real-time subscriptions.
KIS_WS_HTS_ID=

# Webhook URLs commonly embed private tokens; keep them with credentials.
EXTERNAL_ALERT_WEBHOOK_URL=
EXTERNAL_HEARTBEAT_WEBHOOK_URL=
EXTERNAL_ALERT_WEBHOOK_TOKEN=

# --- PC remote-control credentials/private endpoints ---
PC_WAKE_URL=
REMOTE_CONTROL_TOKEN=

# --- Optional integration credentials ---
OPENAI_API_KEY=
