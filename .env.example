# Copy this file to .env and fill in real values.
# .env is gitignored -- never commit actual credentials.

# --- MySQL (optional; app runs without it, see README) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=quant_app

# --- KIS broker API: production ---
# Administrative one-way lock. Keep false on machines that must never submit
# orders. Setting true only permits the in-app per-session toggle; it does not
# auto-enable trading at startup.
TRADING_ENABLED=false
KIS_PROD_BASE_URL=
KIS_PROD_APP_KEY=
KIS_PROD_APP_SECRET=
KIS_PROD_ACCOUNT_NO=

# --- KIS broker API: simulation/paper ---
KIS_SIM_BASE_URL=
KIS_SIM_APP_KEY=
KIS_SIM_APP_SECRET=
KIS_SIM_ACCOUNT_NO=
KIS_SIM_ACCOUNT_PRODUCT_CODE=

# --- KIS intraday (only enable after verifying endpoint/TR ID/field mappings) ---
KIS_INTRADAY_ENABLED=false
KIS_OVERSEAS_INTRADAY_ENDPOINT=
KIS_OVERSEAS_INTRADAY_TR_ID=
KIS_OVERSEAS_INTRADAY_DATE_FIELD=
KIS_OVERSEAS_INTRADAY_TIME_FIELD=
KIS_OVERSEAS_INTRADAY_OPEN_FIELD=
KIS_OVERSEAS_INTRADAY_HIGH_FIELD=
KIS_OVERSEAS_INTRADAY_LOW_FIELD=
KIS_OVERSEAS_INTRADAY_CLOSE_FIELD=
KIS_OVERSEAS_INTRADAY_VOLUME_FIELD=
KIS_OVERSEAS_INTRADAY_OUTPUT_FIELD=
KIS_OVERSEAS_INTRADAY_PARAMS_JSON=

# --- PC sync / remote control (see docs/pc_sync_data_pipeline.md) ---
PC_REMOTE_CONTROL_HOST=
PC_WAKE_URL=
REMOTE_CONTROL_TOKEN=

# --- Optional integrations ---
OPENAI_API_KEY=

# --- Optional: offsite backup dir for gitignored data/*.json state files ---
# Auto-detected if unset and a Google Drive for Desktop folder is present.
# See docs/cloud_backup.md
QUANT_BACKUP_DIR=
