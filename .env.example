# Copy this file to .env and fill in real values.
# .env is gitignored -- never commit actual credentials.

# --- MySQL (optional; app runs without it, see README) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=quant_app

# --- Shared execution coordination (recommended for PC-independent trading) ---
# Use the TiDB Cloud *SQL connection* values shown by Connect, not a TiDB
# management/Data Service API key. Historical prices never use this database.
COORD_DB_HOST=
COORD_DB_PORT=4000
COORD_DB_USER=
COORD_DB_PASSWORD=
COORD_DB_NAME=quant_coordination
# Optional PEM CA path. Relative paths resolve from the repository root.
COORD_DB_SSL_CA=
# Local quote/ORB evaluation remains every second. These settings limit only
# small coordination reads/heartbeats; broker submissions still recheck the
# exact lease and ownership at the execution boundary.
COORDINATION_ACTIVE_CARD_POLL_SECONDS=180
COORDINATION_STANDBY_CARD_POLL_SECONDS=300
COORDINATION_DATABASE_PROBE_SECONDS=180
COORDINATION_LEASE_POLL_SECONDS=20
# The five-second cross-device pulse is local/Tailscale. TiDB receives this
# coarse liveness update plus immediate writes for real operator/state changes.
COORDINATION_DEVICE_HEARTBEAT_SECONDS=240
COORDINATION_DEVICE_HEARTBEAT_MAX_AGE_SECONDS=300
COORDINATION_OWNERSHIP_PROOF_SECONDS=30
COORDINATION_ALERT_POLL_SECONDS=90
# Fast liveness uses the external HTTPS webhook; only compact hourly/status
# evidence uses TiDB.
EXTERNAL_WATCHDOG_HEARTBEAT_SECONDS=5
EXTERNAL_WATCHDOG_TIDB_AUDIT_SECONDS=3600
EXTERNAL_ALERT_ACK_REMINDER_SECONDS=21600
COORDINATION_OPERATOR_COMMAND_POLL_SECONDS=20
COORDINATION_OFF_HOURS_POLL_SECONDS=300
COORDINATION_STATE_SYNC_SECONDS=180
COORDINATION_BOARD_PROJECTION_SECONDS=180
# Used only after the Tailscale listener confirms change-pulse v2/v3. Normal
# remote changes reconcile immediately without polling TiDB.
COORDINATION_REMOTE_FALLBACK_SECONDS=3600
# Broker reconciliation remains minutely. This is the cache fallback when the
# Tailscale change-token protocol is unavailable; protocol v3 invalidates only
# the table families named by relevant local/remote DML.
COORDINATION_RECONCILIATION_CACHE_SECONDS=900
# The one-second quote/stop loop stays unchanged. Stable pending-order rows are
# reused for two seconds; ambiguous/unknown submissions retain one-second checks.
PENDING_ORDER_RECONCILIATION_SECONDS=2
UNKNOWN_ORDER_RECONCILIATION_SECONDS=1

# --- KIS broker API: production ---
# Per-machine administrative one-way lock. Keep false on machines that must
# never submit orders. Setting true permits the canonical shared Live Trading
# control; its durable ON/OFF value is common to laptop and PC. Main-device
# lease/readiness gates still decide which one may actually execute.
TRADING_ENABLED=false
KIS_PROD_BASE_URL=
KIS_PROD_APP_KEY=
KIS_PROD_APP_SECRET=
KIS_PROD_ACCOUNT_NO=

# --- KIS broker API: simulation/paper ---
KIS_SIM_BASE_URL=
KIS_SIM_APP_KEY=
KIS_SIM_APP_SECRET=
KIS_SIM_ACCOUNT_NO=
KIS_SIM_ACCOUNT_PRODUCT_CODE=

# --- KIS real-time WebSocket market data (Workstream 5; read-only) ---
# Keep the WebSocket transport disabled until docs/kis_capability_matrix.md is
# completed with live, redacted evidence. The Buy Board engine itself remains
# available independently in mutation-blocked mode.
KIS_WS_ENABLED=false
KIS_WS_PROTOCOL_VERIFIED=false
# Normal production composition requires all three values and verifies them
# before opening the socket. Keep the evidence bundle outside the repository.
KIS_CAPABILITY_MANIFEST_PATH=
KIS_CAPABILITY_MANIFEST_SHA256=
KIS_RUNTIME_COMMIT_SHA=
KANBAN_STRATEGY_INSTANCE_ID=buyboard-orb-v1
KIS_PROD_WS_URL=ws://ops.koreainvestment.com:21000
KIS_SIM_WS_URL=ws://ops.koreainvestment.com:31000
KIS_WS_HTS_ID=
# JSON map of symbol to the exact live-verified KIS subscription key.
# Example shape only: {"AAPL":"<verified key>"}
KIS_WS_SYMBOL_KEYS_JSON={}
KIS_MARKET_DATA_MODE=REST_DISPLAY_ONLY
KIS_MARKET_DATA_FALLBACK_MODE=DISPLAY_ONLY
ORB_FORMATION_SOURCE=KIS_MINUTE_BARS
KIS_WS_APPROVAL_KEY_TTL_SECONDS=82800
KIS_WS_AUTH_MAX_RETRIES=3
KIS_WS_RECONNECT_INITIAL_SECONDS=1
KIS_WS_RECONNECT_MAX_SECONDS=30
KIS_WS_RECONNECT_JITTER_SECONDS=0.5
KIS_WS_SUBSCRIPTION_ACK_TIMEOUT_SECONDS=5
BROKER_EVENT_STALE_SECONDS=3
LOCAL_RECEIVE_STALE_SECONDS=3
MAX_MARKET_DATA_QUEUE_DELAY_SECONDS=1
MAX_BROKER_CLOCK_SKEW_SECONDS=5
MAX_FUTURE_BROKER_EVENT_SECONDS=1
# Populate only with limits verified by Workstream 0. Zero blocks subscription.
KIS_WS_TOTAL_SUBSCRIPTION_CAPACITY=0
KIS_WS_TRADE_CHANNEL_CAPACITY=0
KIS_WS_QUOTE_CHANNEL_CAPACITY=0
KIS_WS_RAW_CAPTURE_ENABLED=false
MARKET_DATA_OUTAGE_GRACE_SECONDS=15
MARKET_DATA_OUTAGE_MAX_HOLD_SECONDS=120
MARKET_DATA_OUTAGE_RISK_BUFFER_PCT=0.01
MARKET_DATA_OUTAGE_LOSS_THRESHOLD_PCT=0.02
MARKET_DATA_OUTAGE_SUPERVISED_HOLD_ONLY=false
MARKET_DATA_OUTAGE_ACCOUNT_RISK_PCT=0.01
MARKET_DATA_OUTAGE_CONCENTRATION_PCT=0.20
MARKET_DATA_OUTAGE_STOP_DISTANCE_ATR=0.5
EMERGENCY_EXIT_MAX_REPRICE_ATTEMPTS=3
EMERGENCY_LEASE_ALLOWANCE_SECONDS=30
# Keep false until Workstream 0 has captured live, redacted evidence for the
# exact account/endpoint limits. Zero/unknown capacities keep entries closed.
KIS_MUTATION_BUDGET_VERIFIED=false
KIS_SUBMIT_MUTATION_CAPACITY=0
KIS_CANCEL_MUTATION_CAPACITY=0
KIS_REPLACE_MUTATION_CAPACITY=0
KIS_MUTATION_BUDGET_WINDOW_SECONDS=1
# Shared pacing across every KIS HTTP endpoint; 0.1s leaves headroom under the
# broker's per-second transaction allowance.
KIS_REQUEST_MIN_SPACING_SECONDS=0.1
KIS_MUTATION_MIN_SPACING_SECONDS=0.2
# 1 disables scheduler-level mutation retry, including explicit pre-acceptance
# rate-limit refusal. Reconciliation owns every later decision.
KIS_MUTATION_MAX_CONFIRMED_ATTEMPTS=1

# Additional Kanban production fence. CONTROLLED_LIVE requires a nonempty
# symbol list, positive entry cap, reviewed budgets, WebSocket capability
# manifest, >=0.1s mutation spacing, and zero automatic mutation retry.
KIS_LIVE_EXECUTION_MODE=DISABLED
KIS_CONTROLLED_LIVE_SYMBOLS=
KIS_CONTROLLED_LIVE_MAX_ENTRY_NOTIONAL=0

# Keep the guarded Buy Board runtime available. This flag does not authorize
# broker calls; KIS_LIVE_EXECUTION_MODE=DISABLED blocks every production
# submit/sell/cancel, and the remaining execution fences still apply.
BUYBOARD_ENGINE_ENABLED=true

# Account-wide entry limits. Values are decimal fractions: 0.10 means 10%,
# while 10.0 means 1,000%. These never block SELL/cancel/reconciliation.
# Daily loss, drawdown, and classification limits remain zero until their
# corresponding fresh canonical providers are configured.
PORTFOLIO_MAX_SIMULTANEOUS_POSITIONS=30
PORTFOLIO_MAX_TOTAL_OPEN_RISK_FRACTION=0.10
PORTFOLIO_MAX_GROSS_NOTIONAL_FRACTION=10.0
PORTFOLIO_MAX_INCREMENTAL_BUYING_POWER_FRACTION=0
PORTFOLIO_MAX_DAILY_LOSS_FRACTION=0
PORTFOLIO_MAX_DRAWDOWN_FRACTION=0
PORTFOLIO_MAX_SECTOR_NOTIONAL_FRACTION=0
PORTFOLIO_MAX_INDUSTRY_NOTIONAL_FRACTION=0
PORTFOLIO_MAX_CORRELATION_GROUP_NOTIONAL_FRACTION=0
PORTFOLIO_MAX_STRATEGY_NOTIONAL_FRACTION=0
PORTFOLIO_MAX_FX_AGE_SECONDS=300

# Production WS12 delivery path. These must be provisioned, along with the
# out-of-process missing-heartbeat watchdog, before engine activation.
EXTERNAL_ALERT_WEBHOOK_URL=
EXTERNAL_HEARTBEAT_WEBHOOK_URL=
EXTERNAL_ALERT_WEBHOOK_TOKEN=

# --- KIS intraday (only enable after verifying endpoint/TR ID/field mappings) ---
KIS_INTRADAY_ENABLED=false
KIS_OVERSEAS_INTRADAY_ENDPOINT=
KIS_OVERSEAS_INTRADAY_TR_ID=
KIS_OVERSEAS_INTRADAY_DATE_FIELD=
KIS_OVERSEAS_INTRADAY_TIME_FIELD=
KIS_OVERSEAS_INTRADAY_OPEN_FIELD=
KIS_OVERSEAS_INTRADAY_HIGH_FIELD=
KIS_OVERSEAS_INTRADAY_LOW_FIELD=
KIS_OVERSEAS_INTRADAY_CLOSE_FIELD=
KIS_OVERSEAS_INTRADAY_VOLUME_FIELD=
KIS_OVERSEAS_INTRADAY_OUTPUT_FIELD=
KIS_OVERSEAS_INTRADAY_PARAMS_JSON=

# --- PC sync / remote control (see docs/pc_sync_data_pipeline.md) ---
PC_REMOTE_CONTROL_HOST=
PC_WAKE_URL=
REMOTE_CONTROL_TOKEN=
# Keep both disabled until the hardware wake/resume checklist in the runbook
# has passed on the actual PC. Configure these on the PC only.
AUTO_CLAIM_MAIN_ON_HANDOFF=0
EXPECTED_AUTO_CLAIM_HOSTNAME=

# Daily 1D refresh enrichment budget. Basic KIS-master profiles are seeded for
# the whole universe at startup; this many stale rows receive Yahoo
# sector/industry enrichment per completed 1D refresh (hard-capped at 2000).
PROFILE_REFRESH_BATCH_SIZE=500

# Nasdaq fills the next quarter's calendar in bulk. Yahoo then adds complete
# quarterly history for this many not-yet-attempted symbols per daily run.
EARNINGS_CALENDAR_HORIZON_DAYS=100
EARNINGS_HISTORY_REFRESH_BATCH_SIZE=100

# --- Optional integrations ---
OPENAI_API_KEY=

# --- Optional: offsite backup dir for gitignored data/*.json state files ---
# Auto-detected if unset and a Google Drive for Desktop folder is present.
# See docs/cloud_backup.md
QUANT_BACKUP_DIR=
